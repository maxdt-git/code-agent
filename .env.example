# Copy to .env and fill in. Never commit .env.
# Several keys per provider: _1, _2, ... (rotated on rate limit / quota).
# The unsuffixed name is also accepted (e.g. OPENROUTER_API_KEY).

# https://openrouter.ai/settings/keys  (base URL: https://openrouter.ai/api/v1)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# https://console.groq.com/keys  (base URL: https://api.groq.com/openai/v1)
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# https://aistudio.google.com/apikey
# (base URL: https://generativelanguage.googleapis.com/v1beta/openai/)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
